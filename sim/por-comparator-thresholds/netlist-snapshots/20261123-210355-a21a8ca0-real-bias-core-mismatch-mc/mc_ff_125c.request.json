{
  "netlist": "netlist.spice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "ff_mm"
    ],
    "supply_v": {
      "vset": [
        3.63
      ]
    },
    "temperature_c": [
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "1u 0.0726 0 2e-05 uic"
  },
  "measurements": [
    {
      "name": "vdd_end",
      "spice": ".meas tran vdd_end FIND v(vdd) AT=0.072599",
      "unit": "V"
    },
    {
      "name": "por_raw_max",
      "spice": ".meas tran por_raw_max MAX v(por_raw)",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 1500,
    "keep_artifacts": true,
    "waveforms": true
  },
  "monte_carlo": {
    "n": 20,
    "seed": 20261210,
    "vary": "mismatch"
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 600.0
  }
}
