{
  "netlist": "netlist.spice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt",
      "ss",
      "ff",
      "sf",
      "fs"
    ],
    "supply_v": {
      "vset": [
        3.63
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "1u 0.1452 0 2e-05"
  },
  "measurements": [
    {
      "name": "vdd_end",
      "spice": ".meas tran vdd_end FIND v(vdd) AT=0.145199",
      "unit": "V"
    },
    {
      "name": "por_raw_max",
      "spice": ".meas tran por_raw_max MAX v(por_raw)",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 1500,
    "keep_artifacts": true,
    "waveforms": true
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 2700.0
  }
}
