| .control
| save all
| tran 10u 10m uic
| let nlast = length(v(ptat))-1
| let meas_ptat = v(ptat)[nlast]
| let meas_ptat_settled = abs(v(ptat)[nlast] - v(ptat)[nlast-100])
| let meas_ctat = v(ctat)[nlast]
| let meas_ctat_settled = abs(v(ctat)[nlast] - v(ctat)[nlast-100])
| let meas_na = v(xdut.na)[nlast]
| let meas_nb = v(xdut.nb)[nlast]
| let meas_isup = -i(v1)[nlast]
| let meas_bias_ok = v(bias_ok)[nlast]
| print meas_ptat
| print meas_ptat_settled
| print meas_ctat
| print meas_ctat_settled
| print meas_na
| print meas_nb
| print meas_isup
| print meas_bias_ok
| quit
| .endc
| .end

