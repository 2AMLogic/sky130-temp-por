{
  "netlist": "netlist.spice",
  "backend": "local",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt"
    ],
    "supply_v": {
      "vset": [
        3.3
      ]
    },
    "temperature_c": [
      27
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "1u 0.015363 0 5e-06"
  },
  "measurements": [
    {
      "name": "vdd_end",
      "spice": ".meas tran vdd_end FIND v(vdd) AT=0.015263",
      "unit": "V"
    },
    {
      "name": "resetn_end",
      "spice": ".meas tran resetn_end FIND v(resetn) AT=0.015263",
      "unit": "V"
    },
    {
      "name": "resetn_max",
      "spice": ".meas tran resetn_max MAX v(resetn)",
      "unit": "V"
    },
    {
      "name": "por_raw_max",
      "spice": ".meas tran por_raw_max MAX v(xdut.por_raw)",
      "unit": "V"
    },
    {
      "name": "ibias_end",
      "spice": ".meas tran ibias_end FIND v(xdut.ibias) AT=0.015263",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 1500,
    "keep_artifacts": true,
    "waveforms": true,
    "ngspice_init": [
      "set ngbehavior=hsa     ; HSPICE-ish compatibility, required to read PDK libs",
      "set skywaterpdk        ; skip some checks for faster lib loading",
      "set ng_nomodcheck      ; do not check model parameters",
      "option noinit          ; do not dump operating point data into the log",
      "option klu             ; KLU direct linear solver"
    ]
  }
}
