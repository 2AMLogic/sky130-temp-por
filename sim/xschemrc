#### Project-local xschemrc for sky130-temp-por's sim/ harness.
####
#### Purpose: make `xschem` find the sky130 symbol library AND this repo's own
#### design/ symbols without relying on anything in the user's ~/.xschem. The
#### corner runner passes this file with `--rcfile`, so batch netlisting and
#### interactive editing share one config.
####
#### Ported from sky130-bandgap/sim/xschemrc (issue #17), with one addition:
#### design/xschemrc already does the "source the PDK's own xschemrc, then
#### append the repo-relative symbol path" pattern for schematic-entry work;
#### this file repeats it (rather than sourcing design/xschemrc directly) so
#### it can also append sim/ itself to the search path, letting a testbench
#### schematic under sim/<slug>/testbench/ instantiate design/*.sym cells by
#### their repo-relative name.
####
#### Interactive use:
####   source sim/bin/pdk-env.sh          # exports PDK_ROOT / PDK
####   xschem --rcfile sim/xschemrc sim/<experiment>/testbench/<tb>.sch
####
#### Everything PDK-specific below is inherited from the PDK's own xschemrc
#### (which sets XSCHEM_LIBRARY_PATH so `sky130_fd_pr/*.sym` resolves, and
#### SKYWATER_MODELS for the corner.sym netlist command).

#### PDK_ROOT / PDK: honour the environment, else fall back to the volare
#### default root. Keep the fallback in sync with sim/pdk.json.
if {![info exists env(PDK_ROOT)] || $env(PDK_ROOT) eq {}} {
  set env(PDK_ROOT) [file normalize ~/.volare]
}
if {![info exists env(PDK)] || $env(PDK) eq {}} {
  set env(PDK) sky130A
}

set _sky130_rc $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
if {![file exists $_sky130_rc]} {
  puts stderr "sky130-temp-por: no PDK xschemrc at $_sky130_rc"
  puts stderr "sky130-temp-por: install the pinned PDK (see sim/README.md) or set PDK_ROOT"
} else {
  source $_sky130_rc
}
unset _sky130_rc

#### Put the repository root AND design/ on the symbol search path so both
#### this project's testbench cells (e.g. sim/bias-core-smoke/testbench/) and
#### its design cells (design/bias_core.sym) resolve by their repo-relative
#### name rather than by an absolute, machine-local path. Appended *after*
#### the PDK entries so a project symbol can never shadow a
#### `sky130_fd_pr/*` one.
set _repo_root [file normalize [file join [file dirname [info script]] ..]]
set _design_dir [file join $_repo_root design]
if {[info exists XSCHEM_LIBRARY_PATH] && $XSCHEM_LIBRARY_PATH ne {}} {
  append XSCHEM_LIBRARY_PATH ":$_repo_root:$_design_dir"
} else {
  set XSCHEM_LIBRARY_PATH "$_repo_root:$_design_dir"
}
unset _repo_root _design_dir

#### Keep xschem's generated netlists out of the tracked tree. The corner
#### runner overrides this with an explicit `-o`, so this only affects
#### interactive netlisting from the GUI.
set netlist_dir [file normalize [file join [file dirname [info script]] build xschem]]
file mkdir $netlist_dir

#### Do not open the PDK's demo schematic when started with no file argument.
set XSCHEM_START_WINDOW {}
