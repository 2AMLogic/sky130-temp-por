{
  "netlist": "tb-iq-por.spice",
  "backend": "local",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt"
    ],
    "supply_v": {
      "vset": [
        3.3
      ]
    },
    "temperature_c": [
      27
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "1u 0.03 0 1e-05"
  },
  "measurements": [
    {
      "name": "iq_por_settled",
      "spice": ".meas tran iq_por_settled AVG i(bvdd) FROM=0.025 TO=0.03",
      "unit": "A"
    }
  ],
  "options": {
    "timeout_s": 3000,
    "keep_artifacts": true
  }
}
