{
  "schema_version": 1,
  "kind": "t1-attestation-inventory",
  "t1_item": 10,
  "description": "Repo hygiene: README, LICENSE and the CI workflows, backed by the stdlib-only audit commands self-checks.yml runs on every push. The SPICE campaigns, layout composition and DRC/LVS are not covered (see manifests/README.md, What CI covers).",
  "hygiene": [
    "README.md",
    "LICENSE",
    ".github/workflows/self-checks.yml",
    ".github/workflows/signoff-manifest.yml"
  ],
  "checks": [
    {
      "name": "committed-netlist-invariants",
      "argv": [
        "python3",
        "design/check_committed_netlists.py"
      ]
    },
    {
      "name": "json-well-formed",
      "argv": [
        "python3",
        ".github/scripts/check_json.py"
      ]
    },
    {
      "name": "characterization-coverage",
      "argv": [
        "python3",
        "-I",
        ".github/scripts/check_characterization_coverage.py"
      ]
    },
    {
      "name": "records-append-only-selftest",
      "argv": [
        "python3",
        "-I",
        ".github/scripts/check_records_append_only.py",
        "--selftest"
      ]
    },
    {
      "name": "ramp-checker-selftest",
      "argv": [
        "python3",
        "sim/supply-ramp-top/ramp_checker.py"
      ]
    },
    {
      "name": "brownout-checker-selftest",
      "argv": [
        "python3",
        "-I",
        "sim/brownout-top/brownout_checker.py"
      ]
    }
  ]
}
